<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CuteTerm</AssemblyName>
    <Version>0.2.0</Version>
    <ApplicationIcon Condition="Exists('assets/CuteTerm.ico')">assets/CuteTerm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="ui/dist/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="commands/bootstrap.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="commands/defaults/*.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckWebAssets" BeforeTargets="Build">
    <Error Condition="!Exists('ui/dist/index.html')" Text="CuteTerm UI is not built. Run powershell -File scripts/build.ps1 (or npm install --prefix ui; npm run build --prefix ui) before dotnet build." />
  </Target>
</Project>
